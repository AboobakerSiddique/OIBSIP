# --- Server ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# NOTE: Order verification uses MongoDB transactions (atomic inventory
# decrement + order creation). This requires a replica set — MongoDB
# Atlas provides one automatically, but a plain local `mongod` does not.
# For local dev, either use Atlas or run `mongod --replSet rs0` and
# initiate it with `rs.initiate()` in the mongo shell.
MONGODB_URI=mongodb://localhost:27017/bella-pizza

# --- Auth (introduced in Phase 3) ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Razorpay test mode (introduced in Phase 5) ---
# Get test-mode keys from https://dashboard.razorpay.com/app/keys
# (toggle "Test Mode" in the dashboard first — test keys are prefixed rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email / SMTP (introduced in Phase 8) ---
# Gmail: use an App Password (not your regular password) — https://myaccount.google.com/apppasswords
# Or use a dev-friendly service like Mailtrap/Ethereal for testing without sending real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Bella Pizza <no-reply@bellapizza.test>"

# Used to build links inside emails (verify-email, reset-password).
# Defaults to CORS_ORIGIN if unset.
FRONTEND_URL=http://localhost:5173

# --- Low-stock notifications (Phase 8) ---
# Cron expression — default is hourly. Use "*/1 * * * *" for every
# minute while testing locally.
LOW_STOCK_CRON_SCHEDULE="0 * * * *"
# Minimum hours between repeat alerts for the same low-stock item.
LOW_STOCK_NOTIFICATION_COOLDOWN_HOURS=24
# Fallback recipient if no admin has configured Settings.notifyEmail
# via PATCH /api/admin/settings.
ADMIN_ALERT_EMAIL=
